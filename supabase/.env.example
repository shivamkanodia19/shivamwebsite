# Set these as Supabase Edge Function secrets; do not commit real values.
ADMIN_PASSWORD_HASH=replace-with-a-generated-pbkdf2-sha256-hash
ADMIN_TOKEN_SECRET=replace-with-a-long-random-token-secret
ADMIN_RATE_LIMIT_SALT=replace-with-a-long-random-rate-limit-salt

# Optional comma-separated development origins. Production always permits
# https://shivamkanodia.com.
ADMIN_ALLOWED_ORIGINS=http://localhost:5173
