# Set these as Supabase Edge Function secrets; do not commit real values. Token
# and rate-limit secrets must be at least 32 characters.
ADMIN_PASSWORD_HASH=replace-with-a-generated-pbkdf2-sha256-hash
ADMIN_TOKEN_SECRET=replace-with-a-long-random-token-secret
ADMIN_RATE_LIMIT_SALT=replace-with-a-long-random-rate-limit-salt

# Generate a hash locally, then copy only the command output into the Supabase
# secret. This reads the password without echoing it and uses a random 16-byte
# salt with PBKDF2-SHA-256 and 600,000 iterations:
# read -rs ADMIN_PASSWORD; export ADMIN_PASSWORD; deno eval 'const e=new TextEncoder(),p=Deno.env.get("ADMIN_PASSWORD")!,s=crypto.getRandomValues(new Uint8Array(16)),k=await crypto.subtle.importKey("raw",e.encode(p),"PBKDF2",false,["deriveBits"]),d=new Uint8Array(await crypto.subtle.deriveBits({name:"PBKDF2",hash:"SHA-256",salt:s,iterations:600000},k,256)),b=(v)=>btoa(String.fromCharCode(...v)).replaceAll("+","-").replaceAll("/","_").replace(/=+$/,""); console.log(`pbkdf2-sha256$600000$${b(s)}$${b(d)}`)'; unset ADMIN_PASSWORD

# Optional comma-separated development origins. Production always permits
# https://shivamkanodia.com. Values must be HTTPS, except explicit localhost
# or 127.0.0.1 HTTP origins for local development.
ADMIN_ALLOWED_ORIGINS=http://localhost:5173

# The login function accepts only Supabase/Cloudflare's cf-connecting-ip header;
# it deliberately ignores x-forwarded-for. A global hashed throttle also caps
# guesses if the trusted address changes between requests.
